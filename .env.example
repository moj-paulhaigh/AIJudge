# Copy this file to .env and fill in your real key. Never commit .env.

# Azure OpenAI credentials used by the LiteLLM proxy and the Judge.
AZURE_API_KEY=your-azure-openai-key-here
AZURE_API_BASE=https://paul-temp-foundry.openai.azure.com/
AZURE_API_VERSION=2025-04-01-preview

# Master key the LiteLLM proxy requires on incoming requests (any string).
LITELLM_MASTER_KEY=sk-aijudge-local-dev

# Where the backend finds the LiteLLM proxy.
AIJUDGE_LITELLM_BASE=http://localhost:4000

# model_name (from litellm_proxy/config.yaml) the backend asks for on behalf
# of the frontend chat UI.
AIJUDGE_CHAT_MODEL=azure-gpt-5.6-luna

# Raw provider model string the Judge calls directly (bypassing the proxy)
# when it needs an LLM-as-judge verdict.
AIJUDGE_JUDGE_MODEL=azure/gpt-5.6-luna

# Where logs, verdicts, and the blocklist are written. Point this at any
# local drive/path you want the data to live on.
AIJUDGE_DATA_DIR=./data

# Optional. Canary token planted in the chat system prompt; if it ever appears
# in an exchange the Judge blocks the session. Leave unset to derive one from
# LITELLM_MASTER_KEY (backend and Judge both compute the same value).
# AIJUDGE_CANARY=
